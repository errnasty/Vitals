# Copy to .env for local development. Railway holds the real values as service
# variables; nothing secret is ever committed.

# ── Core ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=local            # local | staging | production
LOG_LEVEL=INFO

# Postgres. On Railway this is the Postgres service's own DATABASE_URL, referenced as
# ${{Postgres.DATABASE_URL}} so it tracks a password rotation automatically. That URL
# points at the private network (postgres.railway.internal), which is free and not
# reachable from outside the project. From your laptop, use the public proxy URL
# (DATABASE_PUBLIC_URL) instead — same database, billed egress.
#
# Never a transaction pooler: asyncpg creates prepared statements unconditionally.
# `?sslmode=require` is translated to asyncpg's `ssl=` automatically, so paste the URL
# exactly as Railway gives it to you.
DATABASE_URL=postgresql+asyncpg://vitals:vitals@localhost:5432/vitals

# "none" closes each connection with the request that opened it. Set this on any
# Railway service with Serverless enabled: Railway decides a container is idle from its
# outbound packets, and a warm connection pool never stops producing them — so a pooled
# API never sleeps and bills around the clock.
VITALS_DB_POOL_MODE=pooled   # pooled | none

CORS_ORIGINS=http://localhost:3000

# ── Secrets ─────────────────────────────────────────────────────────────────────
# Encrypts Garmin credentials and tokens at rest. Lives only in the Railway
# environment, so a database compromise alone does not surrender the Garmin account.
# Required for every Garmin command; rotating it makes the stored tokens unreadable,
# which shows up as a re-auth prompt rather than silent failure.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VITALS_ENCRYPTION_KEY=

# ── Auth ────────────────────────────────────────────────────────────────────────
# Self-issued (the single-user default): set the secret and nothing else. This
# deployment signs its own tokens with `vitals auth token --email you@example.com`
# and verifies them with HS256. No identity provider to pay for, pause, or rate-limit.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
VITALS_AUTH_JWT_SECRET=

# External provider instead (Supabase, Auth0, Clerk): leave the secret empty and point
# these at the issuer. Tokens are then verified against its published JWKS, and
# `vitals auth token` refuses to mint — the provider is the only one entitled to sign.
# VITALS_AUTH_ISSUER=https://<project>.supabase.co/auth/v1
# VITALS_AUTH_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# Who may use this deployment, comma-separated. Enforced on every request whatever the
# issuer allows; the API refuses to start outside `local` if this is empty.
VITALS_ALLOWED_EMAILS=

# Local-only escape hatch: run the API with no auth at all. Refused anywhere else.
VITALS_AUTH_DISABLED=false

# ── Database capabilities ───────────────────────────────────────────────────────
# pgvector is needed from phase 9 (similar-day search) and nothing before it. Railway's
# official Postgres image does not ship it, so until then its absence is reported by
# /healthz rather than failing the deploy. Turn this on when phase 9 lands.
VITALS_REQUIRE_PGVECTOR=false

# ── AI (phase 7) ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Frontend ────────────────────────────────────────────────────────────────────
# Server-side base URL the web service uses to reach the api service.
API_URL=http://localhost:8000
