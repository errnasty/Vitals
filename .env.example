# Copy to .env for local development. Railway holds the real values as service variables;
# nothing secret is ever committed.

# ── Core ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=local            # local | staging | production
LOG_LEVEL=INFO

# Supabase SESSION pooler (port 5432). Never the transaction pooler (6543): it does not
# support prepared statements and asyncpg creates them unconditionally.
DATABASE_URL=postgresql+asyncpg://vitals:vitals@localhost:5432/vitals

CORS_ORIGINS=http://localhost:3000

# ── Secrets (phase 2+) ──────────────────────────────────────────────────────────
# Encrypts Garmin credentials and tokens at rest in Supabase. Lives only in Railway env,
# so a database compromise alone does not surrender the Garmin account.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VITALS_ENCRYPTION_KEY=

# ── Supabase (phase 1: auth) ────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── AI (phase 7) ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Frontend ────────────────────────────────────────────────────────────────────
# Server-side base URL the web service uses to reach the api service.
API_URL=http://localhost:8000
